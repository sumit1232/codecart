PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/codecart
CLIENT_URL=http://localhost:5173
SERVER_URL=http://localhost:5000
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES=7d

# Email OTP (Gmail: enable 2FA, create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="CodeCart <youremail@gmail.com>"

# Google login (Passport). Redirect URI to register in Google Cloud:
#   http://localhost:5000/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Razorpay (Dashboard > Settings > API Keys). Use Test keys first.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
# Optional backup: Dashboard > Webhooks > URL {SERVER_URL}/api/orders/webhook, event payment.captured
RAZORPAY_WEBHOOK_SECRET=

# Platform commission taken from each sale (shown in seller earnings)
COMMISSION_PERCENT=10

# Used by `npm run seed`
ADMIN_EMAIL=admin@codecart.com
ADMIN_PASSWORD=Admin@12345
